# Use a token belonging to the configured GitHub user, limited to the selected repositories.
GH_TOKEN=
# API-key providers only (including Gemini and Anthropic); leave blank for codex or Vertex ADC.
AI_API_KEY=
# Vertex ADC defaults to ./data/google-application-default-credentials.json inside the container.
# GOOGLE_APPLICATION_CREDENTIALS=/data/google-application-default-credentials.json
# Pin a release, or replace this with your own registry image after publishing a fork.
REVIEWER_IMAGE=johnndelembi/pr-reviewer-local:0.2.0
# Set to your local UID/GID if they differ from 1000, or when initializing bind mounts.
REVIEWER_UID=1000
REVIEWER_GID=1000
